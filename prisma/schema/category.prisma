model Category {
  id String @id @default(uuid())

  name        String  @unique
  icon        String?
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services       Service[]
  requiredSkills Skill[]   @relation("CategorySkills")

  @@map("categories")
}
