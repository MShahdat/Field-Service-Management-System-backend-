model Region {
  id String @id @default(uuid())

  area        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manager     ManagerProfile[]
  services    Service[]
  technicians TechnicianProfile[] @relation("TechnicianRegions")

  @@map("regions")
}
