model Attachment {
  id String @id @default(uuid())

  url         String
  publicId    String
  description String?

  type AttachmentType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("attachments")
}
