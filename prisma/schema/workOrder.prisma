model WorkOrder {
  id String @id @default(uuid())

  servicingDate DateTime
  startedTime   DateTime?
  endTime       DateTime?
  actualStart   DateTime?
  actualEnd     DateTime?

  status WorkOrderStatus @default(SCHEDULED)
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regionId String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  technicianId String?
  technician   TechnicianProfile? @relation(fields: [technicianId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  serviceId String  @unique
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  managerId String
  manager   ManagerProfile @relation(fields: [managerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  attachment    Attachment[]
  serviceReport ServiceReport?
  feedback      Feedback?
  payment       Payment?

  @@map("workOrders")
}
