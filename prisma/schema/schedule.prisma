model Schedule {
  id String @id @default(uuid())

  servicingDate DateTime
  startTime     DateTime
  endTime       DateTime
  actualStart   DateTime?
  actualEnd     DateTime?

  status    ScheduleStatus @default(SCHEDULED)
  isdeleted Boolean        @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  workOrderId String    @unique
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("schedules")
}
