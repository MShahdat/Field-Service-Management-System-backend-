<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <style>
    body { font-family: Arial, sans-serif; background: #f4f4f4; padding: 20px; }
    .container { background: #fff; max-width: 500px; margin: auto; border-radius: 8px; padding: 24px; }
    .header { font-size: 20px; font-weight: bold; color: #1a1a1a; margin-bottom: 8px; }
    .detail-row { margin: 10px 0; font-size: 14px; color: #333; }
    .label { font-weight: bold; color: #555; }
    .rating { color: #f59e0b; font-weight: bold; }
    .btn { display: inline-block; margin-top: 16px; padding: 10px 20px; background: #16a34a; color: #fff; text-decoration: none; border-radius: 6px; }
    .footer { margin-top: 20px; font-size: 12px; color: #999; }
  </style>
</head>
<body>
  <% const formatAddress = (value) => {
    if (!value) return "Not provided";
    if (typeof value === "string") return value;
    return Object.entries(value)
      .map(([key, item]) => `${key}: ${typeof item === "object" ? JSON.stringify(item) : item}`)
      .join(", ");
  }; %>
  <div class="container">
    <div class="header">Technician Assigned to Your Service</div>
    <p>Hi <%= name %>,</p>
    <p>A technician has been assigned to your <%= serviceCategory %> request.</p>

    <div class="detail-row"><span class="label">Technician:</span> <%= technicianName %></div>
    <% if (technicianRating) { %>
      <div class="detail-row"><span class="label">Rating:</span> <span class="rating"><%= technicianRating %>★</span> · <%= jobsCompleted %> jobs completed</div>
    <% } %>
    <% if (technicianPhone) { %>
      <div class="detail-row"><span class="label">Contact:</span> <%= technicianPhone %></div>
    <% } %>
    <div class="detail-row"><span class="label">Service Address:</span> <%= formatAddress(address) %></div>
    <div class="detail-row"><span class="label">Scheduled:</span> <%= scheduledDate %></div>

    <div class="footer">— <%= appName %></div>
  </div>
</body>
</html>