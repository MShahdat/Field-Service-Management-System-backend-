<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <title>Manager Application Approved</title>
</head>

<body
  style="margin:0; padding:0; background-color:#f1f5f9; font-family:'Segoe UI', Arial, Helvetica, sans-serif; -webkit-text-size-adjust:100%;">

  <!-- Preheader (inbox preview text) -->
  <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:#f1f5f9;">
    Your manager application has been approved. Your temporary login password is inside.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
    style="background-color:#f1f5f9; padding:32px 12px;">
    <tr>
      <td align="center">

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
          style="max-width:600px; background-color:#ffffff; border-radius:12px; overflow:hidden; border:1px solid #e2e8f0;">

          <!-- Brand bar -->
          <tr>
            <td style="background-color:#0f172a; padding:22px 32px; text-align:center;">
              <span style="color:#ffffff; font-size:18px; font-weight:700; letter-spacing:0.4px;">
                <%= appName %>
              </span>
            </td>
          </tr>

          <!-- Accent strip -->
          <tr>
            <td style="background-color:#0f9d58; height:4px; font-size:0; line-height:0;">&nbsp;</td>
          </tr>

          <!-- Status badge + title -->
          <tr>
            <td align="center" style="padding:36px 40px 8px 40px;">
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" valign="middle"
                    style="width:60px; height:60px; background-color:#e6f7ec; border-radius:30px; color:#0f9d58; font-size:30px; font-weight:bold; line-height:60px;">
                    &#10003;
                  </td>
                </tr>
              </table>
              <h1 style="margin:20px 0 6px 0; font-size:24px; line-height:1.3; color:#0f172a;">Application Approved</h1>
              <p style="margin:0; font-size:14px; color:#64748b;">Your manager account is ready</p>
            </td>
          </tr>

          <!-- Greeting -->
          <tr>
            <td style="padding:24px 40px 0 40px; color:#334155; font-size:15px; line-height:1.7;">
              <p style="margin:0 0 14px 0;">Dear <strong>
                  <%= name %>
                </strong>,</p>
              <p style="margin:0;">
                Congratulations! Your manager role application on <strong>
                  <%= appName %>
                </strong> has been reviewed and
                <strong style="color:#0f9d58;">approved</strong>. You can now sign in to your manager dashboard to
                oversee
                customers and assign technicians.
              </p>
            </td>
          </tr>

          <!-- Credentials card -->
          <tr>
            <td style="padding:28px 40px 0 40px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                style="background-color:#f8fafc; border:1px solid #e2e8f0; border-radius:10px;">
                <tr>
                  <td style="padding:20px 24px;">
                    <p
                      style="margin:0 0 14px 0; font-size:12px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#64748b;">
                      Your login credentials
                    </p>

                    <% if (typeof email !=='undefined' && email) { %>
                      <p style="margin:0 0 4px 0; font-size:13px; color:#64748b;">Email</p>
                      <p
                        style="margin:0 0 16px 0; font-size:15px; font-weight:600; color:#0f172a; word-break:break-all;">
                        <%= email %>
                      </p>
                      <% } %>

                        <p style="margin:0 0 6px 0; font-size:13px; color:#64748b;">Temporary password</p>
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                          <tr>
                            <td
                              style="background-color:#ffffff; border:1px dashed #0f9d58; border-radius:8px; padding:14px 16px; text-align:center;">
                              <span
                                style="font-family:'Courier New', Consolas, monospace; font-size:20px; font-weight:700; letter-spacing:2px; color:#0f172a; word-break:break-all;">
                                <%= password %>
                              </span>
                            </td>
                          </tr>
                        </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Security notice -->
          <tr>
            <td style="padding:16px 40px 0 40px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                style="background-color:#fffbeb; border-left:4px solid #f59e0b; border-radius:4px;">
                <tr>
                  <td style="padding:14px 18px; color:#78350f; font-size:13.5px; line-height:1.6;">
                    <strong>&#9888; Security notice</strong><br />
                    This password was generated automatically and is for one-time use. Please sign in and
                    <strong>change it immediately</strong> from your dashboard settings. Never share it with anyone.
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Next steps -->
          <tr>
            <td style="padding:28px 40px 0 40px; color:#334155; font-size:14.5px; line-height:1.7;">
              <p style="margin:0 0 10px 0; font-weight:700; color:#0f172a;">What's next?</p>
              <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td valign="top" style="width:28px; padding:0 0 8px 0; color:#0f9d58; font-weight:700;">1.</td>
                  <td style="padding:0 0 8px 0;">Sign in with the temporary password above.</td>
                </tr>
                <tr>
                  <td valign="top" style="width:28px; padding:0 0 8px 0; color:#0f9d58; font-weight:700;">2.</td>
                  <td style="padding:0 0 8px 0;">Change your password and complete your profile.</td>
                </tr>
                <tr>
                  <td valign="top" style="width:28px; padding:0; color:#0f9d58; font-weight:700;">3.</td>
                  <td style="padding:0;">Start reviewing customer service requests and assigning technicians.</td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- CTA -->
          <tr>
            <td align="center" style="padding:32px 40px 8px 40px;">
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" style="background-color:#0f9d58; border-radius:8px;">
                    <a href="<%= (typeof loginUrl !== 'undefined' && loginUrl) ? loginUrl : '#' %>"
                      style="display:inline-block; padding:14px 36px; color:#ffffff; text-decoration:none; font-size:15px; font-weight:700;">
                      Sign in to Dashboard
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Closing -->
          <tr>
            <td style="padding:24px 40px 32px 40px; color:#334155; font-size:14.5px; line-height:1.7;">
              <p style="margin:0;">
                Welcome aboard, and thank you for joining our network of trusted Field Service Management professionals.
              </p>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding:0 40px;">
              <hr style="border:none; border-top:1px solid #e2e8f0; margin:0;" />
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding:22px 40px 28px 40px; color:#94a3b8; font-size:12px; line-height:1.6;">
              <p style="margin:0 0 6px 0;">This is an automated message. Please do not reply directly to this email.</p>
              <p style="margin:0;">&copy; <%= new Date().getFullYear() %>
                  <%= appName %>. All rights reserved.</p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>
</body>

</html>